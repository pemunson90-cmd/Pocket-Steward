+                        path = cleaned.path.ifBlank { existing.path },
+                        aliases = (cleaned.aliases + existing.aliases + existing.name + cleaned.name),
+                        packageIds = cleaned.packageIds + existing.packageIds,
+                        hierarchy = cleaned.hierarchy,
+                    ),
+                )
+            }
