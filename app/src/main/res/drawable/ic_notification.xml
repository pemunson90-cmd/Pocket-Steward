<?xml version="1.0" encoding="utf-8"?>
<!--
  Status bar icon. Android draws this slot as a single-color silhouette, so it
  must be a flat shape on transparency; the full-color adaptive launcher icon
  rendered as a blank square here. Same folder glyph as the launcher,
  re-framed to fill a 24dp status bar slot.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="60"
    android:viewportHeight="60">
    <group android:translateX="-24" android:translateY="-27">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M30,40 L46,40 L52,48 L78,48 L78,74 L30,74 Z" />
    </group>
</vector>
